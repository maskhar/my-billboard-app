# Deployed development template. Copy to deployment secret storage; no real secrets.
# NODE_ENV stays production because this environment runs a built Next.js image.
NODE_ENV="production"

POSTGRES_USER="billboard_dev"
POSTGRES_PASSWORD="GENERATE_A_DIFFERENT_URL_SAFE_DATABASE_PASSWORD"
POSTGRES_DB="billboard_dev"
DATABASE_URL="postgresql://billboard_dev:SAME_URL_ENCODED_PASSWORD@billboard-db-dev:5432/billboard_dev?schema=public"

NEXTAUTH_SECRET="GENERATE_A_SEPARATE_DEV_SECRET_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="https://dev-billboard.uteroindonesia.com"
GOOGLE_CLIENT_ID="GOOGLE_DEV_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_DEV_OAUTH_CLIENT_SECRET"

SETTINGS_ENCRYPTION_KEY="GENERATE_A_SEPARATE_64_HEX_DEV_KEY"

XENDIT_SECRET_KEY="XENDIT_SANDBOX_SECRET_KEY"
XENDIT_CALLBACK_TOKEN="XENDIT_SANDBOX_CALLBACK_TOKEN"
XENDIT_API_BASE_URL=""
APP_ORIGIN="https://dev-billboard.uteroindonesia.com"

SMTP_HOST="SMTP_HOSTNAME"
SMTP_PORT="587"
SMTP_USER="SMTP_USERNAME"
SMTP_PASS="SMTP_PASSWORD"
MAIL_FROM="Billboard Utero Dev <no-reply@uteroindonesia.com>"
ADMIN_EMAIL="DEVELOPMENT_OPERATIONS_EMAIL_ADDRESS"

CRON_SECRET="GENERATE_A_SEPARATE_DEV_SECRET_WITH_OPENSSL_RAND_HEX_32"
PRIVATE_UPLOAD_STORAGE_ROOT="/data/billboard-dev/private-uploads"

# Chat remains disabled. NEXT_PUBLIC_* values must exist before next build.
NEXT_PUBLIC_CHAT_ENABLED="false"
NEXT_PUBLIC_CHAT_URL=""

# Optional public Cloudinary browser-upload configuration.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_PRESET=""
