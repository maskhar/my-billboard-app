# Production template. Copy to deployment secret storage; never commit real values.
NODE_ENV="production"

POSTGRES_USER="billboard_prod"
POSTGRES_PASSWORD="GENERATE_A_URL_SAFE_DATABASE_PASSWORD"
POSTGRES_DB="billboard_prod"
DATABASE_URL="postgresql://billboard_prod:SAME_URL_ENCODED_PASSWORD@billboard-db-prod:5432/billboard_prod?schema=public"

NEXTAUTH_SECRET="GENERATE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="https://billboard.uteroindonesia.com"
GOOGLE_CLIENT_ID="GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_OAUTH_CLIENT_SECRET"

SETTINGS_ENCRYPTION_KEY="GENERATE_64_HEX_CHARACTERS_WITH_OPENSSL_RAND_HEX_32"

XENDIT_SECRET_KEY="XENDIT_PRODUCTION_SECRET_KEY"
XENDIT_CALLBACK_TOKEN="XENDIT_PRODUCTION_CALLBACK_TOKEN"
XENDIT_API_BASE_URL=""
APP_ORIGIN="https://billboard.uteroindonesia.com"

SMTP_HOST="SMTP_HOSTNAME"
SMTP_PORT="587"
SMTP_USER="SMTP_USERNAME"
SMTP_PASS="SMTP_PASSWORD"
MAIL_FROM="Billboard Utero <no-reply@uteroindonesia.com>"
ADMIN_EMAIL="OPERATIONS_EMAIL_ADDRESS"

CRON_SECRET="GENERATE_WITH_OPENSSL_RAND_HEX_32"
PRIVATE_UPLOAD_STORAGE_ROOT="/data/billboard-prod/private-uploads"

# Chat remains disabled. NEXT_PUBLIC_* values must exist before next build.
NEXT_PUBLIC_CHAT_ENABLED="false"
NEXT_PUBLIC_CHAT_URL=""

# Optional public Cloudinary browser-upload configuration.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_PRESET=""
