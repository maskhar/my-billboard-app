// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// [BARU] Generator khusus untuk chat-server
generator chatClient {
  provider = "prisma-client-js"
  output   = "../chat-server/node_modules/.prisma/client"
}

// Generator `backendClient` dihapus bersama folder `backend/` (22 Sep 2026).
// Membiarkannya membuat setiap `prisma generate` gagal karena direktori
// tujuannya sudah tidak ada.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUM — daftar nilai yang sah
//
// Sebelumnya semua kolom di bawah bertipe `String`, jadi database menerima
// APA SAJA: salah ketik, huruf besar-kecil yang beda, nilai yang tidak pernah
// dikenali kode mana pun. Semua lolos diam-diam dan baru terasa sebagai
// "tombolnya tidak muncul" atau "ordernya hilang dari tab".
//
// PENTING soal huruf besar-kecil: label di bawah SENGAJA mengikuti tulisan
// yang sudah dipakai kode, bukan konvensi Prisma yang biasanya UPPER_CASE.
// `Available` (bukan `AVAILABLE`) dan `upload`/`service` (bukan `UPLOAD`)
// adalah keputusan sadar. Kalau diseragamkan ke huruf besar, perbandingan
// seperti `billboard.status !== 'Available'` di booking/create/route.ts
// akan SELALU benar — artinya setiap pemesanan ditolak, tanpa pesan error
// apa pun. Jangan "dirapikan" tanpa mengubah semua titik bacanya sekaligus.
// ============================================================================

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  OPERATOR
  CS
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum BillboardStatus {
  Available
  Booked
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID_CONFIRMED
  DESIGN_RECEIVED
  IN_PRODUCTION
  INSTALLATION
  ACTIVE
  REVIEW_REFUND
  WAITING_BANK
  PROCESS_REFUND
  REFUNDED
  CANCELLED
}

enum DesignStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Huruf kecil, mengikuti nilai yang dikirim CheckoutForm dan dibandingkan
// di 6 tempat sebagai `=== 'service'`.
enum DesignOption {
  upload
  service
}

// Untuk apa satu pembayaran ditagihkan. Dipakai `Payment.tujuan`.
//
// Dibedakan karena satu pesanan bisa ditagih beberapa kali dengan arti yang
// berbeda, dan angkanya tidak boleh tercampur: DP adalah sebagian dari
// `totalPrice`, PELUNASAN adalah sisanya, sedangkan TAMBAHAN berada DI LUAR
// `totalPrice` (lihat `AdditionalCharge`). Tanpa pembeda ini, menjumlahkan
// seluruh pembayaran sebuah pesanan menghasilkan angka yang tidak bisa
// dibandingkan dengan apa pun.
enum PaymentTujuan {
  DP         // pembayaran muka, sebagian dari totalPrice
  FULL       // sekali bayar penuh sebesar totalPrice
  PELUNASAN  // sisa setelah DP
  TAMBAHAN   // menagih AdditionalCharge, di luar totalPrice
}

enum PaymentStatus {
  PENDING  // tagihan dibuat, uang belum masuk
  PAID     // uang dipastikan masuk oleh webhook gerbang pembayaran
  EXPIRED  // lewat tenggat tanpa dibayar
  VOIDED   // dibatalkan sebelum dibayar (mis. pesanannya batal)
}

enum ChatSessionStatus {
  OPEN
  AGENT
  CLOSED
}

enum ChatSender {
  USER
  ADMIN
  BOT
  SYSTEM
}

// 1. MODEL USER
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   
  image         String?   
  
  // Komentar lama menyebut 4 role, padahal `CS` sudah dipakai di seed dan
  // di 6 route API chat. Sekarang daftarnya ada di `enum Role`, satu tempat.
  role          Role      @default(USER)

  whatsapp      String?
  companyName   String?
  
  // Tambahan dari gambar
  ktp           String?
  npwp          String?
  ktpAddress    String?
  officeAddress String?
  username      String?   @unique

  // ID pelanggan yang dibuat oleh Xendit (`cust-...`). `customer.reference_id`
  // pada Xendit harus unik: mengirim email/user id yang sama ke endpoint create
  // customer untuk pembayaran kedua menghasilkan 409 DUPLICATE_ERROR. Karena
  // itu hasil create pertama disimpan dan dipakai ulang, bukan dibuat ulang
  // untuk setiap sesi pembayaran.
  xenditCustomerId String? @unique

  // === FITUR BARU ===
  authProvider  AuthProvider @default(EMAIL)
  isVerified    Boolean   @default(false)
  
  // `otpCode` dan `otpExpires` DIHAPUS (task 3.27).
  //
  // Keduanya tidak pernah ditulis maupun dibaca oleh satu baris kode pun —
  // nol referensi di seluruh repo. Yang tersisa hanyalah dua kolom yang ikut
  // terbawa setiap kali kode memakai `include: { user: true }` tanpa
  // `select`, yaitu bentuk kebocoran data yang sama dengan kolom `password`.
  // Kolom kosong yang tidak dipakai tetap punya biaya: ia terkirim ke mana
  // pun barisnya pergi.
  //
  // Bila verifikasi OTP benar-benar dibangun nanti, kolomnya dibuat ulang
  // bersama kodenya, bukan sebelum.
  // ==================

  createdAt     DateTime  @default(now())

  // Tanpa kolom ini tidak ada cara mengetahui kapan sebuah akun terakhir
  // diubah. Saat ada sengketa — "role saya berubah sendiri", "nomor WA saya
  // diganti orang" — satu-satunya jawaban yang bisa diberikan sistem adalah
  // tanggal pendaftaran.
  updatedAt     DateTime  @updatedAt @default(now())

  bookings          Booking[] 
  createdBillboards Billboard[] @relation("CreatedBy")
  updatedBillboards Billboard[] @relation("UpdatedBy")
  auditLogs         BillboardHistory[] 
}


// 2. MODEL BILLBOARD
model Billboard {
  id          String   @id @default(cuid())
  slug        String   @unique @default(cuid()) 
  
  title       String
  sku         String?  @unique
  address     String
  type        String
  // Uang TIDAK BOLEH `Float`. Float menyimpan angka dalam basis 2, jadi
  // 0.1 + 0.2 tidak persis 0.3 — selisihnya sangat kecil tapi menumpuk
  // lewat penjumlahan dan persentase (PPN 11%, DP 60%, refund 90%),
  // dan nominal di layar bisa meleset dari nominal yang ditagih.
  // `Decimal(15,2)` menyimpan angka desimal apa adanya: cukup untuk
  // Rp 9.999.999.999.999,99 dengan 2 angka di belakang koma.
  price       Decimal  @db.Decimal(15, 2)

  lat         Float    // koordinat peta, bukan uang — Float memang tepat
  lng         Float

  status        BillboardStatus @default(Available)
  publishStatus PublishStatus   @default(DRAFT)

  mainImage   String
  videoUrl    String?
  smartsucoUrl String?

  // Empat kolom di bawah dulu bertipe String dan menyimpan JSON sebagai teks:
  // setiap penulis memanggil `JSON.stringify`, setiap pembaca `JSON.parse`.
  // Database karena itu tidak pernah bisa menolak isi yang rusak — teks kosong,
  // kutip yang hilang, atau data berformat lama tersimpan dengan tenang, dan
  // baru meledak saat dibaca, di halaman produk publik, jauh dari sumbernya.
  //
  // Sekarang jsonb: database yang memvalidasi bentuknya saat ditulis, Prisma
  // yang menguraikannya saat dibaca. `jsonb` dipilih, bukan `json`, karena ia
  // tersimpan sudah terurai (dibaca tanpa parse ulang) dan bisa diindeks bila
  // suatu saat perlu dicari isinya. Kekhawatiran "jsonb mengacak urutan" tidak
  // berlaku di sini: ia hanya mengurutkan ulang KUNCI di dalam objek, bukan
  // ELEMEN di dalam array — urutan foto galeri dan urutan baris spesifikasi
  // tetap terjaga.
  //
  // Non-null dengan default `[]`, bukan opsional: kolom Json opsional punya TIGA
  // keadaan kosong yang tidak bisa dibedakan pembaca (SQL NULL, JSON null, dan
  // array kosong), dan Prisma bahkan memaksa penulis memilih di antaranya lewat
  // `Prisma.DbNull`/`Prisma.JsonNull`. Tidak satu pun pembaca di proyek ini
  // membedakan ketiganya — semuanya hanya menanyakan `.length > 0`.
  gallery     Json     @default("[]")
  specs       Json     @default("[]")
  includes    Json     @default("[]")
  excludes    Json     @default("[]")


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi User Pembuat/Pengedit
  createdById   String?
  createdBy     User?    @relation("CreatedBy", fields: [createdById], references: [id])
  
  updatedById   String?
  updatedBy     User?    @relation("UpdatedBy", fields: [updatedById], references: [id])

  // Relasi Booking
  bookings      Booking[]

  // [PERBAIKAN ERROR TADI]
  history       BillboardHistory[]

  // Halaman depan selalu menyaring dengan dua kolom ini sekaligus
  // (`status: 'Available'` + `publishStatus: 'PUBLISHED'`). Tanpa indeks,
  // database membaca SELURUH tabel setiap kali halaman dibuka.
  @@index([publishStatus, status])
  @@index([createdById])
  @@index([updatedById])
}

// 3. MODEL BOOKING
model Booking {
  id            String   @id @default(cuid())
  userId        String
  billboardId   String
  
  startDate     DateTime
  duration      Int
  endDate       DateTime
  
  // Lihat catatan Decimal di Billboard.price.
  //
  // RINCIAN TAGIHAN
  // ---------------
  // Sebelumnya hanya `totalPrice` yang disimpan — satu angka jadi, hasil
  // hitungan di browser pembeli. Tidak ada cara memeriksa ulang angka itu:
  // tidak diketahui harga satuannya berapa, pajaknya berapa, biaya adminnya
  // berapa. Bila tarif berubah bulan depan, invoice lama pun ikut berubah
  // karena harus dihitung ulang dari harga billboard yang sekarang.
  //
  // Empat kolom di bawah merekam rincian pada SAAT pemesanan dibuat, jadi
  // invoice lama tetap menceritakan angka yang benar-benar disepakati waktu
  // itu. Diisi oleh server (Fase 2.2), bukan oleh browser.
  //
  // Nullable karena baris yang sudah ada tidak punya rinciannya.
  unitPrice     Decimal? @db.Decimal(15, 2) // harga sewa per bulan saat dipesan
  basePrice     Decimal? @db.Decimal(15, 2) // unitPrice × duration, sebelum pajak
  taxAmount     Decimal? @db.Decimal(15, 2) // PPN
  adminFee      Decimal? @db.Decimal(15, 2) // biaya administrasi

  totalPrice    Decimal  @db.Decimal(15, 2)
  dpAmount      Decimal? @db.Decimal(15, 2)

  status        BookingStatus @default(PENDING_PAYMENT)

  // Batas waktu pembayaran. Dulu tenggat 24 jam hanya dihitung di browser
  // dari `createdAt` (lihat BookingCard.tsx) — hitung mundur di layar habis,
  // tapi pesanannya tetap hidup di database dan tanggalnya tetap terkunci
  // selamanya. Dengan kolom ini, tenggatnya menjadi fakta yang tercatat dan
  // bisa ditegakkan di sisi server.
  expiresAt     DateTime?

  designOption  DesignOption
  designFileUrl String?

  // Tetap nullable: NULL = user belum mengirim desain sama sekali.
  // `PENDING_REVIEW` = desain sudah masuk, menunggu admin.
  // Dua keadaan berbeda, jangan digabung.
  designStatus  DesignStatus?
  designRejectionReason String?

  // -- Timestamps for Tracking --
  paidAt            DateTime? // Waktu pembayaran dikonfirmasi
  designApprovedAt  DateTime? // Waktu desain disetujui
  productionStartedAt DateTime? // Waktu mulai cetak/produksi
  updatedAt         DateTime  @updatedAt // Waktu update terakhir

  cancelReason    String?
  refundProof     String?
  userBankName    String? 
  userBankAccount String? 
  refundAmount    Decimal?  @db.Decimal(15, 2)
  refundedAt      DateTime?
  isLocked        Boolean   @default(false)
  
  // `onDelete: Restrict` ditulis TEGAS di sini (task 3.16), bukan dibiarkan
  // mengandalkan default Prisma.
  //
  // Sebuah booking adalah bukti transaksi: siapa membayar berapa, untuk
  // titik mana, kapan dipasang. Menghapus akun pengguna atau menghapus
  // billboard tidak boleh diam-diam melenyapkan bukti itu. Dengan Restrict,
  // database MENOLAK penghapusan selama masih ada booking yang menunjuk ke
  // sana — jadi penghapusan menjadi keputusan yang harus dihadapi admin
  // secara sadar (lihat `api/admin/users/delete`, yang menghapus booking
  // lebih dulu di dalam satu transaksi), bukan efek samping senyap.
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  billboard     Billboard @relation(fields: [billboardId], references: [id], onDelete: Restrict)
  
  createdAt     DateTime  @default(now())

  // -- BARU: BUKTI TAYANG --
  installationProof String? // Foto Billboard sudah terpasang
  installedAt       DateTime? // Tanggal dipasang

  // -- BARU: BIAYA TAMBAHAN --
  additionalCharges AdditionalCharge[]

  // -- RIWAYAT PEMBAYARAN --
  payments      Payment[]

  // Tiga pola query yang paling sering dipakai:
  // daftar order milik satu user, tab status di dashboard admin,
  // dan pengecekan tanggal bentrok per billboard.
  @@index([userId, status])
  @@index([status])
  @@index([billboardId, startDate, endDate])
}

// 8. PEMBAYARAN
//
// KENAPA TABEL, BUKAN BEBERAPA KOLOM DI BOOKING
// ---------------------------------------------
// Sebelum tabel ini ada, "berapa uang yang sudah masuk" tidak pernah disimpan.
// Ia DITEBAK dari `dpAmount`: kalau kolom itu berisi angka, dianggap yang masuk
// baru DP; kalau nol, dianggap sudah lunas (lihat `uangYangSudahMasuk` di
// api/booking/request-refund). Tebakan itu benar hanya selama satu pesanan
// dibayar tepat satu kali. Begitu ada pelunasan sisa DP, ia langsung salah:
// pesanan yang sudah lunas penuh tetap dihitung baru menyetor DP, dan refund
// dihitung dari angka yang lebih kecil daripada uang yang benar-benar diterima.
//
// Dua kolom skalar (`paidAmount`, `paidAt`) tidak menyelesaikannya, karena
// jumlah pembayaran per pesanan memang tidak terbatas: `AdditionalCharge` berada
// DI LUAR `totalPrice` dan admin boleh menambahkannya SETELAH pelunasan. Jadi
// satu pesanan bisa punya DP, pelunasan, lalu beberapa tagihan tambahan.
// Angka tunggal `paidAmount` akan terus ditimpa dan riwayatnya hilang.
//
// Dengan tabel ini, uang masuk menjadi HASIL PENJUMLAHAN baris berstatus PAID —
// fakta yang tercatat, bukan kesimpulan yang ditarik ulang setiap kali dibaca.
//
// SATU BARIS = SATU SESI PEMBAYARAN, BUKAN SATU KEWAJIBAN
// -------------------------------------------------------
// Aturan ini menentukan seluruh alur di atasnya, jadi ditulis tegas:
//
//   - Satu baris Payment mewakili SATU sesi pembayaran di Xendit. Sesi itu
//     sendiri sudah menampung beberapa percobaan bayar — pembeli yang gagal di
//     tengah jalan bisa mencoba lagi pada tautan yang sama.
//   - Sesi yang KEDALUWARSA tidak bisa dihidupkan kembali oleh Xendit. Jadi
//     ketika pembeli ingin mencoba lagi setelah tenggat sesi lewat, barisnya
//     ditandai EXPIRED dan dibuatkan baris BARU untuk sesi yang baru.
//   - Karena itu `providerSessionId` tidak pernah ditimpa. Kalau ia ditimpa,
//     webhook dari sesi yang lama tidak bisa lagi dicocokkan ke baris mana pun
//     — dan webhook Xendit bisa tiba terlambat sampai 24 jam, jadi sesi lama
//     yang ternyata benar-benar dibayar akan hilang tanpa jejak.
//
// Yang TIDAK disimpan di tabel ini adalah "kewajiban melunasi". Kewajiban itu
// bukan baris, melainkan hasil hitungan: `totalPrice` dikurangi jumlah semua
// baris PAID. Menyimpannya sebagai baris tersendiri berarti ada dua sumber
// kebenaran yang harus terus disamakan.
//
// Indeks unik bersyarat `payment_satu_tagihan_menganggur` (ditulis tangan di
// migrasi, karena Prisma tidak bisa menyatakannya) menjaga agar hanya ada SATU
// baris PENDING per (bookingId, tujuan) — itulah yang menegakkan keputusan
// pemilik proyek bahwa pelunasan dibayar sekali penuh, tidak dicicil.
model Payment {
  id        String        @id @default(cuid())
  bookingId String
  // `Restrict`, sama alasannya dengan relasi di Booking: baris ini adalah bukti
  // uang berpindah. Menghapus pesanan tidak boleh diam-diam melenyapkannya.
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  tujuan    PaymentTujuan
  status    PaymentStatus @default(PENDING)

  // Lihat catatan Decimal di Billboard.price. Nominal yang DITAGIHKAN pada
  // tagihan ini — bukan total pesanan.
  jumlah    Decimal       @db.Decimal(15, 2)

  // -- Kaitan ke gerbang pembayaran (Xendit) --
  //
  // `@unique` pada id sesi bukan sekadar kerapian: webhook mencari baris
  // Payment berdasarkan nilai ini. Bila dua baris bisa memuat id yang sama,
  // webhook tidak punya cara menentukan mana yang dilunasi.
  // Dibuat SEBELUM memanggil Xendit, lalu dikirim sebagai `reference_id`.
  // Ini jalur pemulihan bila proses mati setelah Xendit membuat sesi tapi
  // sebelum `providerSessionId` sempat tersimpan: webhook tetap dapat mencari
  // tepat satu baris lewat reference ini, bukan membuang pembayaran sah hanya
  // karena jendela kegagalan beberapa milidetik.
  providerReferenceId String? @unique
  providerSessionId   String? @unique
  // Satu Payment ID Xendit merepresentasikan satu transaksi uang nyata. Unik
  // agar webhook yang salah cari/diulang tidak bisa menautkannya ke dua baris
  // internal dan membuat satu pembayaran tercatat dua kali.
  providerPaymentId   String? @unique

  // Tautan Hosted Checkout milik satu sesi. Disimpan agar pembeli yang menekan
  // tombol Bayar lagi dibawa ke sesi yang MASIH aktif, bukan dibuatkan tagihan
  // kedua untuk kewajiban yang sama. URL ini bukan rahasia; ia hanya tetap
  // diberikan setelah server membuktikan pemanggil adalah pemilik Booking.
  providerCheckoutUrl String?

  // Isi webhook disimpan apa adanya. Saat ada sengketa — "saya sudah bayar",
  // "nominalnya bukan itu" — inilah satu-satunya bukti tentang apa yang
  // sebenarnya dikirim gerbang pembayaran. Jsonb, dengan alasan yang sama
  // seperti kolom JSON di Billboard.
  callbackPayload Json?

  // Kapan sesi pada baris INI kedaluwarsa di sisi gerbang pembayaran. Sesi
  // Xendit berumur pendek (default 30 menit) sedangkan kewajiban pelunasan
  // boleh hidup beberapa hari sampai tenggat H-3. Ketika sesi kedaluwarsa,
  // baris ini menjadi EXPIRED lalu sesi pengganti mendapat baris Payment BARU;
  // kolom ini tidak pernah dipakai untuk menimpa sesi lama.
  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Riwayat pembayaran satu pesanan, urut waktu.
  @@index([bookingId, createdAt])
  // Penyapu tagihan kedaluwarsa menyaring dengan dua kolom ini.
  @@index([status, expiresAt])
}

// 7. BIAYA TAMBAHAN
model AdditionalCharge {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  // Baris ini adalah tagihan kepada pelanggan. Bila nominalnya pernah
  // dikoreksi, waktunya harus tercatat — kalau tidak, invoice hari ini dan
  // invoice minggu lalu bisa berbeda tanpa satu pun jejak yang menjelaskannya.
  updatedAt   DateTime @updatedAt @default(now())
}


// 4. SETTING WEBSITE
model SystemSetting {
  id               String  @id @default("default_config")
  siteName         String  @default("Utero Cloud")
  siteDesc         String  @default("Platform Sewa Billboard Terlengkap")
  geminiApiKey     String? 
  googleMapsApiKey String?
  updatedAt        DateTime @updatedAt
}

// 5. LIVE CHAT
model ChatSession {
  id          String   @id @default(cuid())
  guestName   String
  guestEmail  String
  guestPhone  String
  status      ChatSessionStatus @default(OPEN)
  isOnline    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  // `AGENT` sengaja tidak masuk enum: CS_InboxLayout mengirimnya, tapi
  // chat-server menimpanya sebelum menyimpan, jadi nilai itu tidak pernah
  // sampai ke database.
  sender        ChatSender
  message       String
  createdAt     DateTime    @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id])

  // Setiap membuka satu percakapan = ambil pesan satu sesi, urut waktu.
  @@index([sessionId, createdAt])
}

// 6. RIWAYAT PERUBAHAN BILLBOARD (AUDIT LOGS)
model BillboardHistory {
  id          String   @id @default(cuid())
  
  // Relasi Balik ke Billboard
  billboardId String
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  
  title       String
  price       Decimal  @db.Decimal(15, 2)

  // Tipe yang sama dengan Billboard.status. Harus sama, karena rollback
  // menyalin nilai ini kembali ke Billboard.status apa adanya.
  status      BillboardStatus

  // Relasi Balik ke User (Siapa yang mengubah)
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  
  archivedAt  DateTime @default(now())
  snapshot    String

  // Tabel ini seharusnya hanya ditambahi, tidak pernah diubah. Justru karena
  // itu kolom ini berguna: bila suatu hari ada baris yang `updatedAt`-nya
  // tidak sama dengan `archivedAt`, itu bukti bahwa riwayat pernah disunting.
  // Tanpa kolom ini penyuntingan seperti itu tidak meninggalkan jejak apa pun.
  updatedAt   DateTime @updatedAt @default(now())

  // Riwayat satu billboard, terbaru dulu.
  @@index([billboardId, archivedAt])
  @@index([changedById])
}

