// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// [BARU] Generator khusus untuk chat-server
generator chatClient {
  provider = "prisma-client-js"
  output   = "../chat-server/node_modules/.prisma/client"
}

// [BARU] Generator khusus untuk backend server
generator backendClient {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. MODEL USER
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   
  image         String?   
  
  role          String    @default("USER") // USER, ADMIN, SUPER_ADMIN, OPERATOR
  
  whatsapp      String?
  companyName   String?
  
  // Tambahan dari gambar
  ktp           String?
  npwp          String?
  ktpAddress    String?
  officeAddress String?
  username      String?   @unique
  
  // === FITUR BARU ===
  authProvider  String    @default("EMAIL") // "EMAIL" atau "GOOGLE"
  isVerified    Boolean   @default(false)
  
  otpCode       String?   // Kode rahasia sementara
  otpExpires    DateTime?
  // ==================
  
  createdAt     DateTime  @default(now())
  
  bookings          Booking[] 
  createdBillboards Billboard[] @relation("CreatedBy")
  updatedBillboards Billboard[] @relation("UpdatedBy")
  auditLogs         BillboardHistory[] 
}


// 2. MODEL BILLBOARD
model Billboard {
  id          String   @id @default(cuid())
  slug        String   @unique @default(cuid()) 
  
  title       String
  sku         String?  @unique
  address     String
  type        String
  price       Float
  lat         Float
  lng         Float
  status      String   @default("Available")
  publishStatus String @default("DRAFT")
  
  mainImage   String
  gallery     String 
  videoUrl    String?
  smartsucoUrl String?

  specs       String   
  includes    String  
  excludes    String 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi User Pembuat/Pengedit
  createdById   String?
  createdBy     User?    @relation("CreatedBy", fields: [createdById], references: [id])
  
  updatedById   String?
  updatedBy     User?    @relation("UpdatedBy", fields: [updatedById], references: [id])

  // Relasi Booking
  bookings      Booking[]

  // [PERBAIKAN ERROR TADI]
  history       BillboardHistory[]
}

// 3. MODEL BOOKING
model Booking {
  id            String   @id @default(cuid())
  userId        String
  billboardId   String
  
  startDate     DateTime
  duration      Int
  endDate       DateTime
  
  totalPrice    Float
  dpAmount      Float?
  status        String   @default("PENDING_PAYMENT")
  
  designOption  String   
  designFileUrl String?
  designStatus  String? // PENDING_REVIEW, APPROVED, REJECTED
  designRejectionReason String?

  // -- Timestamps for Tracking --
  paidAt            DateTime? // Waktu pembayaran dikonfirmasi
  designApprovedAt  DateTime? // Waktu desain disetujui
  productionStartedAt DateTime? // Waktu mulai cetak/produksi
  updatedAt         DateTime  @updatedAt // Waktu update terakhir

  cancelReason    String?
  refundProof     String?
  userBankName    String? 
  userBankAccount String? 
  refundAmount    Float?  
  refundedAt      DateTime?
  isLocked        Boolean   @default(false)
  
  user          User      @relation(fields: [userId], references: [id])
  billboard     Billboard @relation(fields: [billboardId], references: [id])
  
  createdAt     DateTime  @default(now())

  // -- BARU: BUKTI TAYANG --
  installationProof String? // Foto Billboard sudah terpasang
  installedAt       DateTime? // Tanggal dipasang

  // -- BARU: BIAYA TAMBAHAN --
  additionalCharges AdditionalCharge[]
}

// 7. BIAYA TAMBAHAN
model AdditionalCharge {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  createdAt   DateTime @default(now())
}


// 4. SETTING WEBSITE
model SystemSetting {
  id               String  @id @default("default_config")
  siteName         String  @default("Utero Cloud")
  siteDesc         String  @default("Platform Sewa Billboard Terlengkap")
  geminiApiKey     String? 
  googleMapsApiKey String?
  updatedAt        DateTime @updatedAt
}

// 5. LIVE CHAT
model ChatSession {
  id          String   @id @default(cuid())
  guestName   String
  guestEmail  String
  guestPhone  String
  status      String   @default("OPEN")
  isOnline    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  sender        String
  message       String
  createdAt     DateTime    @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id])
}

// 6. RIWAYAT PERUBAHAN BILLBOARD (AUDIT LOGS)
model BillboardHistory {
  id          String   @id @default(cuid())
  
  // Relasi Balik ke Billboard
  billboardId String
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  
  title       String
  price       Float
  status      String
  
  // Relasi Balik ke User (Siapa yang mengubah)
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  
  archivedAt  DateTime @default(now())
  snapshot    String 
}

