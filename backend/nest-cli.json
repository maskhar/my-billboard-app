{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "prisma/**/*.ts", "outDir": "dist/src" },
      { "include": "prisma/**/*.js", "outDir": "dist/src" },
      { "include": "prisma/schema.prisma", "outDir": "dist/prisma" }
    ]
  }
}
