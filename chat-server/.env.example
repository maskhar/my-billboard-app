# chat-server/.env.example
#
# Server chat berjalan sebagai PROSES SENDIRI (port 3001), terpisah dari Next.
# Ia memuat berkas ini lewat `require("dotenv").config()` di `index.js:1`, jadi
# `.env` di akar repo TIDAK terbaca olehnya. Itulah kenapa daftar ini ada
# terpisah: `chat-server/.env` yang hanya berisi dua kunci membuat empat kunci
# lainnya jatuh ke nilai bawaan tanpa satu pun galat saat start.
#
# Isi salinannya di `chat-server/.env` (tidak ikut Git). Nilai contoh di bawah
# sengaja kosong — tidak ada satu pun rahasia yang ditulis di berkas ini.

# ---------------------------------------------------------------------------
# WAJIB — server menolak melayani atau salah melayani tanpa ini
# ---------------------------------------------------------------------------

# Dibaca `PrismaClient` (index.js:73) secara implisit. Sama seperti DATABASE_URL
# di akar repo: satu database, dua proses.
DATABASE_URL=

# index.js:76. Dipakai memverifikasi token sesi NextAuth staf
# (`next-auth/jwt`.decode, index.js:92). WAJIB SAMA dengan NEXTAUTH_SECRET
# aplikasi Next — kalau berbeda, tidak ada satu pun petugas yang bisa masuk ke
# room chat, dan gejalanya hanya "koneksi ditolak" tanpa sebab yang terlihat.
NEXTAUTH_SECRET=

# index.js:33. Daftar origin yang boleh menyambung, dipisah koma.
#
# PERINGATAN: kosong TIDAK gagal tertutup. `index.js:36-41` jatuh ke
# DEFAULT_DEV_ORIGINS (localhost) dengan hanya `console.warn`, jadi di produksi
# server akan menolak origin produksinya sendiri sementara satu-satunya tanda
# adalah satu baris peringatan di log start. Isi ini sebelum deploy.
CHAT_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# OPSIONAL — ada nilai bawaannya, tapi bawaannya punya konsekuensi
# ---------------------------------------------------------------------------

# index.js:75. Tanpa ini balasan AI mati; chat manusia-ke-manusia tetap jalan.
# RAHASIA.
GEMINI_API_KEY=

# index.js:78. RAHASIA. Menandatangani token tamu (belum login), TTL 30 hari.
# Kosong = jatuh ke NEXTAUTH_SECRET. Berfungsi, tapi menyatukan dua kunci untuk
# dua kelompok pemakai yang berbeda: memutar rahasia sesi staf otomatis
# membatalkan seluruh sesi tamu juga.
CHAT_GUEST_TOKEN_SECRET=

# index.js:74. Bawaan 3001. Harus cocok dengan NEXT_PUBLIC_CHAT_URL di `.env`
# akar repo, yang dipakai browser untuk menyambung.
PORT=

# index.js:229. Batas permintaan AI seluruh server per menit. Bawaan 120.
CHAT_AI_BATAS_GLOBAL_PER_MENIT=
