# URL aplikasi dan API
NEXT_PUBLIC_API_URL=http://localhost:4001
BACKEND_API_URL=http://localhost:4001
NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=ganti-dengan-string-acak-panjang

# Login Google (Google Cloud Console > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=isi-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=isi-client-secret

# Database PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/nama_database

# Admin dan keamanan
ADMIN_EMAIL=admin@example.com
PAYMENT_WEBHOOK_SECRET=ganti-dengan-string-acak

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
MAIL_FROM="Utero Billboard <no-reply@example.com>"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_PRESET=preset-upload

# Opsional: host yang diizinkan lewat proxy, dipisah koma
PROXY_ALLOWED_HOSTS=
