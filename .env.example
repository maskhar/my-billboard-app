# Local development only: copy to .env at repository root.
# Docker Compose reads POSTGRES_* from .env; app containers read it via env_file.
# Deployed environments use .env.production.example or .env.development.example.
POSTGRES_USER=billboard_local
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_URL_SAFE_PASSWORD
POSTGRES_DB=billboard_local
# Host-based Next.js uses localhost:5434; compose.app.yml overrides this URL
# to postgres:5432 for containers.
DATABASE_URL=postgresql://billboard_local:REPLACE_WITH_A_UNIQUE_URL_SAFE_PASSWORD@localhost:5434/billboard_local?schema=public

NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_ORIGIN=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with openssl rand -hex 32 when enabling encrypted settings.
SETTINGS_ENCRYPTION_KEY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_API_BASE_URL=
PAYMENT_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_EMAIL=
CRON_SECRET=

# Browser values: compose.app.yml overrides NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_CHAT_ENABLED=false
NEXT_PUBLIC_CHAT_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# compose.app.yml sets private upload path in frontend container.
PRIVATE_UPLOAD_STORAGE_ROOT=
BACKEND_API_URL=http://localhost:4001
